{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": false,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "preserve",
    "lib": [
      "ES2022",
      "dom"
    ],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": true,
    "paths": {
      "@flight-demo/domain/booking": [
        "./libs/domain/booking/src/index.ts"
      ],
      "@flight-demo/domain/boarding": [
        "./libs/domain/boarding/src/index.ts"
      ],
      "@flight-demo/domain/checkin": [
        "./libs/domain/checkin/src/index.ts"
      ],
      "@flight-demo/shared/core": [
        "./libs/shared/core/src/index.ts"
      ],
      "@flight-demo/shared/navigation": [
        "./libs/shared/navigation/src/index.ts"
      ],
      "@flight-demo/shared/state": [
        "./libs/shared/state/src/index.ts"
      ],
      "@flight-demo/domain/booking-api-boarding": [
        "./libs/domain/booking/src/lib/api-boarding/api.ts"
      ]
    }
  },
  "exclude": [
    "node_modules",
    "tmp"
  ]
}
